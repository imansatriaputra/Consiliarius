# ─── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Strongly recommended ─────────────────────────────────────────────────────

# Your Telegram chat ID — restricts MANSA to only respond to you
# Get it by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Voice input (Groq Whisper) ───────────────────────────────────────────────

# Groq API key for voice transcription
# Get it at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── Voice output (ElevenLabs) ────────────────────────────────────────────────

# ElevenLabs API key
# Get it at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice ID — the specific voice MANSA speaks in
# See README for how to find this
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
